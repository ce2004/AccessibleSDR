diff --git a/win32/sdr_compat.c b/win32/sdr_compat.c
new file mode 100644
index 0000000..818af37
--- /dev/null
+++ b/win32/sdr_compat.c
@@ -0,0 +1,61 @@
+/* SDR local change: POSIX helpers missing from mingw-w64, for the native Windows build. */
+#ifdef _WIN32
+#define SDR_COMPAT_IMPL
+#undef gethostname	/* the force-included sdr_compat.h redirects it here */
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <stdio.h>
+#include <string.h>
+#include <signal.h>
+
+static void sdr_wsa_init(void)
+{
+	static int done;
+	WSADATA w;
+	if (!done) {
+		WSAStartup(MAKEWORD(2, 2), &w);
+		done = 1;
+	}
+}
+
+/* runs before main(): netout/statsd call getaddrinfo()/socket() directly */
+__attribute__((constructor)) static void sdr_compat_init(void)
+{
+	sdr_wsa_init();
+}
+
+int sdr_gethostname(char *name, int len)
+{
+	sdr_wsa_init();
+	if (gethostname(name, len) != 0) {
+		strncpy(name, "acarsdec", len);
+		return -1;
+	}
+	return 0;
+}
+
+char *strsep(char **stringp, const char *delim)
+{
+	char *s = *stringp, *e;
+	if (!s)
+		return NULL;
+	e = s + strcspn(s, delim);
+	if (*e)
+		*e++ = '\0';
+	else
+		e = NULL;
+	*stringp = e;
+	return s;
+}
+
+const char *strsignal(int sig)
+{
+	switch (sig) {
+	case SIGINT: return "SIGINT";
+	case SIGTERM: return "SIGTERM";
+	case SIGBREAK: return "SIGBREAK";
+	default: return "signal";
+	}
+}
+#endif
diff --git a/win32/sdr_compat.h b/win32/sdr_compat.h
new file mode 100644
index 0000000..ee6e273
--- /dev/null
+++ b/win32/sdr_compat.h
@@ -0,0 +1,55 @@
+/* SDR local change: force-included (-include) POSIX shims for the native Windows ARM64
+ * llvm-mingw build. Only what acarsdec actually uses. */
+#ifndef SDR_COMPAT_H
+#define SDR_COMPAT_H
+#ifdef _WIN32
+
+#include <signal.h>
+#include <string.h>
+#include <time.h>
+
+#define ffs __builtin_ffs
+
+static inline char *sdr_stpcpy(char *d, const char *s)
+{
+	size_t n = strlen(s);
+	memcpy(d, s, n + 1);
+	return d + n;
+}
+#define stpcpy sdr_stpcpy
+
+/* struct timeval.tv_sec is a 32-bit long on Windows but time_t is 64-bit:
+ * take the value so gmtime_r(&tv.tv_sec, ...) works for both */
+static inline struct tm *sdr_gmtime_r(time_t t, struct tm *tm)
+{
+	return gmtime_s(tm, &t) ? NULL : tm;
+}
+#define gmtime_r(tp, tm) sdr_gmtime_r((time_t)*(tp), (tm))
+
+#ifndef SIGQUIT
+#define SIGQUIT SIGBREAK
+#endif
+
+struct sigaction {
+	void (*sa_handler)(int);
+	int sa_mask;
+	int sa_flags;
+};
+#define sigemptyset(m) (*(m) = 0, 0)
+static inline int sigaction(int sig, const struct sigaction *act, struct sigaction *old)
+{
+	(void)old;
+	return signal(sig, act->sa_handler) == SIG_ERR ? -1 : 0;
+}
+
+char *strsep(char **stringp, const char *delim);
+const char *strsignal(int sig);
+
+/* winsock needs WSAStartup before gethostname()/getaddrinfo(); done in sdr_compat.c */
+int sdr_gethostname(char *name, int len);
+#ifndef SDR_COMPAT_IMPL
+#define gethostname sdr_gethostname
+#endif
+
+#endif /* _WIN32 */
+#endif /* SDR_COMPAT_H */
