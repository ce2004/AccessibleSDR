diff --git a/win32/err.h b/win32/err.h
new file mode 100644
index 0000000..031f3ec
--- /dev/null
+++ b/win32/err.h
@@ -0,0 +1,24 @@
+/* SDR local change: BSD <err.h> shim for mingw-w64 */
+#ifndef SDR_ERR_H
+#define SDR_ERR_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <errno.h>
+
+static inline void sdr_vwarn(int with_errno, const char *fmt, va_list ap)
+{
+	int e = errno;
+	fputs("acarsdec: ", stderr);
+	if (fmt)
+		vfprintf(stderr, fmt, ap);
+	if (with_errno)
+		fprintf(stderr, "%s%s", fmt ? ": " : "", strerror(e));
+	fputc('\n', stderr);
+}
+static inline void warn(const char *fmt, ...) { va_list ap; va_start(ap, fmt); sdr_vwarn(1, fmt, ap); va_end(ap); }
+static inline void warnx(const char *fmt, ...) { va_list ap; va_start(ap, fmt); sdr_vwarn(0, fmt, ap); va_end(ap); }
+static inline void err(int code, const char *fmt, ...) { va_list ap; va_start(ap, fmt); sdr_vwarn(1, fmt, ap); va_end(ap); exit(code); }
+static inline void errx(int code, const char *fmt, ...) { va_list ap; va_start(ap, fmt); sdr_vwarn(0, fmt, ap); va_end(ap); exit(code); }
+#endif
