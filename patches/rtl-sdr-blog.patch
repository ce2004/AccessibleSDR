diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index 82bab6d..89eb9a0 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -1960,6 +1960,17 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 
 	_rtlsdr_alloc_async_buffers(dev);
 
+#ifdef _WIN32
+	/* SDR local change: WinUSB without RAW_IO idles the pipe between transfers and the
+	   RTL2832's small FIFO drops samples. RAW_IO keeps all queued transfers streaming.
+	   Requires transfer lengths that are multiples of the max packet size (512). */
+	if (libusb_endpoint_supports_raw_io(dev->devh, 0x81) == 1 &&
+	    dev->xfer_buf_len <= (uint32_t)libusb_get_max_raw_io_transfer_size(dev->devh, 0x81)) {
+		if (libusb_endpoint_set_raw_io(dev->devh, 0x81, 1) == 0)
+			fprintf(stderr, "WinUSB RAW_IO enabled.\n");
+	}
+#endif
+
 	for(i = 0; i < dev->xfer_buf_num; ++i) {
 		libusb_fill_bulk_transfer(dev->xfer[i],
 					  dev->devh,
@@ -2034,6 +2045,11 @@ int rtlsdr_read_async(rtlsdr_dev_t *dev, rtlsdr_read_async_cb_t cb, void *ctx,
 
 	_rtlsdr_free_async_buffers(dev);
 
+#ifdef _WIN32
+	/* RAW_IO would also apply to rtlsdr_read_sync, which may use other lengths */
+	libusb_endpoint_set_raw_io(dev->devh, 0x81, 0);
+#endif
+
 	dev->async_status = next_status;
 
 	return r;
