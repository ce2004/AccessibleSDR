diff --git a/src/input.c b/src/input.c
index 1e96d23..ed6cbe3 100644
--- a/src/input.c
+++ b/src/input.c
@@ -89,11 +89,39 @@ static unsigned int decimate_samples(input_t *st, const uint8_t* in, const uint3
     return avail;
 }
 
+/* SDR local change: quarter-sample-rate offset tuning. When nrsc5_qshift is +1 the tuner sits
+   fs/4 above the station and samples are rotated up by fs/4 (-1: below / down). Rotating by
+   multiples of j is exact on cu8 data (negation is 255 - x), so no extra noise is added. */
+int nrsc5_qshift;
+static uint32_t qshift_n;
+
+static const uint8_t *qshift_cu8(const uint8_t *buf, uint32_t len)
+{
+    static uint8_t *tmp;
+    static uint32_t cap;
+    if (cap < len) { free(tmp); tmp = malloc(len); cap = len; }
+    for (uint32_t k = 0; k + 1 < len; k += 2)
+    {
+        uint8_t i = buf[k], q = buf[k + 1];
+        switch ((qshift_n++ & 3) * nrsc5_qshift)
+        {
+        case 1: case -3: tmp[k] = 255 - q; tmp[k + 1] = i; break;          /* x j  */
+        case 2: case -2: tmp[k] = 255 - i; tmp[k + 1] = 255 - q; break;    /* x -1 */
+        case 3: case -1: tmp[k] = q; tmp[k + 1] = 255 - i; break;          /* x -j */
+        default: tmp[k] = i; tmp[k + 1] = q; break;
+        }
+    }
+    return tmp;
+}
+
 void input_push_cu8(input_t *st, const uint8_t *buf, const uint32_t len)
 {
     float complex out[FFTCP_FM];
     uint32_t consumed = 0;
 
+    if (nrsc5_qshift)
+        buf = qshift_cu8(buf, len);
+
     nrsc5_report_iq(st->radio, buf, len);
 
     assert(len % 4 == 0);
