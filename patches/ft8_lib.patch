+#if defined(_WIN32) && !defined(HAVE_STPCPY)
+// SDR local change: the Windows CRT has no stpcpy
+static char* sdr_stpcpy(char* dst, const char* src)
+{
+    size_t n = strlen(src);
+    memcpy(dst, src, n + 1);
+    return dst + n;
+}
+#define stpcpy sdr_stpcpy
