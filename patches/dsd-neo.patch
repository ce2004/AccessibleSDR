diff --git a/src/core/audio/dsd_audio2.c b/src/core/audio/dsd_audio2.c
index 2e391d5..49aa9bf 100644
--- a/src/core/audio/dsd_audio2.c
+++ b/src/core/audio/dsd_audio2.c
@@ -177,6 +177,11 @@ dsd_audio_reset_short_lr_working_state(dsd_state* state) {
     dsd_audio_maybe_reset_output_ring_right(state);
 }
 
+/* SDR local change: --stdout-mono downmixes stereo (L=slot1, R=slot2) stdout audio to one channel.
+ * Identical L/R (FDMA voice duplicated to both sides) passes through unchanged; differing
+ * channels (two TDMA slots) are summed with clipping. Set from runtime/cli/args.c. */
+int dsd_sdr_stdout_mono = 0;
+
 DSD_AUDIO2_INTERNAL void
 dsd_output_float_block(dsd_opts* opts, dsd_state* state, const float* samples, size_t frames, int channels) {
     if (opts->audio_out != 1 || !samples || frames == 0) {
@@ -187,6 +192,25 @@ dsd_output_float_block(dsd_opts* opts, dsd_state* state, const float* samples, s
     } else if (opts->audio_out_type == 8) {
         dsd_udp_audio_hook_blast(opts, state, frames * (size_t)channels * sizeof(float), (void*)samples);
     } else if (opts->audio_out_type == 1) {
+        if (dsd_sdr_stdout_mono && channels == 2) { /* SDR local change: stereo->mono for stdout */
+            float mono[1024];
+            size_t done = 0;
+            while (done < frames) {
+                size_t n = frames - done;
+                if (n > 1024) {
+                    n = 1024;
+                }
+                for (size_t k = 0; k < n; k++) {
+                    float l = samples[(done + k) * 2];
+                    float r = samples[(done + k) * 2 + 1];
+                    float m = (l == r) ? l : (l + r);
+                    mono[k] = (m > 1.0f) ? 1.0f : ((m < -1.0f) ? -1.0f : m);
+                }
+                write_audio_out(opts->audio_out_fd, mono, n * sizeof(float));
+                done += n;
+            }
+            return;
+        }
         write_audio_out(opts->audio_out_fd, samples, frames * (size_t)channels * sizeof(float));
     }
 }
@@ -201,6 +225,25 @@ dsd_output_s16_block(dsd_opts* opts, dsd_state* state, const short* samples, siz
     } else if (opts->audio_out_type == 8) {
         dsd_udp_audio_hook_blast(opts, state, frames * (size_t)channels * sizeof(short), (void*)samples);
     } else if (opts->audio_out_type == 1) {
+        if (dsd_sdr_stdout_mono && channels == 2) { /* SDR local change: stereo->mono for stdout */
+            short mono[1024];
+            size_t done = 0;
+            while (done < frames) {
+                size_t n = frames - done;
+                if (n > 1024) {
+                    n = 1024;
+                }
+                for (size_t k = 0; k < n; k++) {
+                    int l = samples[(done + k) * 2];
+                    int r = samples[(done + k) * 2 + 1];
+                    int m = (l == r) ? l : (l + r);
+                    mono[k] = (short)((m > 32767) ? 32767 : ((m < -32768) ? -32768 : m));
+                }
+                write_audio_out(opts->audio_out_fd, mono, n * sizeof(short));
+                done += n;
+            }
+            return;
+        }
         write_audio_out(opts->audio_out_fd, samples, frames * (size_t)channels * sizeof(short));
     }
 }
