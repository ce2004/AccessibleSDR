diff --git a/rawstdin.c b/rawstdin.c
new file mode 100644
index 0000000..91e4b2e
--- /dev/null
+++ b/rawstdin.c
@@ -0,0 +1,98 @@
+/*
+ * SDR local change: raw audio input from stdin.
+ *
+ * Reads single-channel signed 16-bit little-endian PCM (already AM-demodulated by the
+ * caller) from stdin at INTRATE * rateMult Hz (-m, default 4 => 48000 Hz; -m 1 => 12000 Hz)
+ * and feeds it through the same path as the libsndfile input (box-average decimation to
+ * INTRATE, half-scale normalisation, demodMSK). Built only when WITH_STDIN is defined.
+ *
+ * This code is free software; you can redistribute it and/or modify it under the terms of
+ * the GNU Library General Public License version 2.
+ */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#ifdef _WIN32
+#include <io.h>
+#include <fcntl.h>
+#endif
+#include "acarsdec.h"
+#include "msk.h"
+#include "rawstdin.h"
+
+#define MAXNBFRAMES 4096
+
+#define ERRPFX	"ERROR: STDIN: "
+
+int initRawStdin(char *optarg)
+{
+	(void)optarg;
+
+	if (!R.rateMult)
+		R.rateMult = 4U;	// 48000 Hz
+
+#ifdef _WIN32
+	// the Windows CRT opens stdin in text mode: 0x1A would end the stream and CR/LF get folded
+	_setmode(_fileno(stdin), _O_BINARY);
+#endif
+
+	R.channels = calloc(1, sizeof(*R.channels));
+	if (!R.channels) {
+		perror(NULL);
+		return -1;
+	}
+	R.nbch = 1;
+
+	R.channels[0].dm_buffer = malloc(sizeof(*R.channels[0].dm_buffer) * MAXNBFRAMES);
+	if (!R.channels[0].dm_buffer) {
+		perror(NULL);
+		return -1;
+	}
+
+	fprintf(stderr, "stdin: s16le mono at %u Hz\n", INTRATE * R.rateMult);
+	return 0;
+}
+
+int runRawStdinSample(void)
+{
+	const unsigned int mult = R.rateMult;
+	int16_t *raw = malloc(sizeof(*raw) * MAXNBFRAMES * mult);
+	size_t have = 0;	// samples currently in raw[]
+	unsigned int i, j, nbi;
+	float d;
+
+	if (!raw) {
+		perror(NULL);
+		return -1;
+	}
+
+	while (R.running) {
+		size_t n = fread(raw + have, sizeof(*raw), (size_t)MAXNBFRAMES * mult - have, stdin);
+		if (!n)
+			break;
+		have += n;
+
+		nbi = (unsigned int)(have / mult);
+		if (!nbi)
+			continue;
+
+		for (i = 0; i < nbi; i++) {
+			for (d = 0, j = 0; j < mult; j++) {
+				const uint8_t *p = (const uint8_t *)&raw[i * mult + j];
+				d += (float)(int16_t)(p[0] | (p[1] << 8)) / 32768.0F;	// little endian
+			}
+			R.channels[0].dm_buffer[i] = d / mult / 2;	// normalize to half-scale like sndfile input
+		}
+		demodMSK(&R.channels[0], nbi);
+
+		// keep any leftover partial group
+		size_t used = (size_t)nbi * mult;
+		memmove(raw, raw + used, (have - used) * sizeof(*raw));
+		have -= used;
+	}
+
+	free(raw);
+	return 0;
+}
